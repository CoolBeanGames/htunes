<Window x:Class="HTunes.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="hTunes" Width="1280" Height="820" MinWidth="980" MinHeight="640" Background="#F4F5F7" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Window.Resources>
  <SolidColorBrush x:Key="Line" Color="#D8DCE3"/>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="NavButton" TargetType="RadioButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Padding="14,10" Background="Transparent" CornerRadius="5" Margin="5,1"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#E4ECFB"/><Setter Property="Foreground" Value="#174A9C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#EDF1F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Background="#FAFAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <MenuItem x:Name="FileMenu" Header="_File"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="EditMenu" Header="_Edit"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="ViewMenu" Header="_View"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="PlaybackMenu" Header="_Playback"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem Header="_Settings"><MenuItem Header="Settings…" Click="Settings_Click"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="About hTunes" Click="About_Click"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Width="570" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="MusicTab" Grid.Column="0" Content="♫  Music" Tag="Music" Checked="TopTab_Checked" Style="{StaticResource NavButton}" IsChecked="True" HorizontalContentAlignment="Center"/><RadioButton x:Name="PodcastsTab" Grid.Column="1" Content="◉  Podcasts" Tag="Podcasts" Checked="TopTab_Checked" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"/><RadioButton Grid.Column="2" Content="↓  Download" Style="{StaticResource NavButton}" IsEnabled="False" ToolTip="Coming next" HorizontalContentAlignment="Center"/><RadioButton x:Name="IPodTab" Grid.Column="3" Content="▣  iPod" Tag="IPod" Checked="TopTab_Checked" Style="{StaticResource NavButton}" Visibility="Collapsed" HorizontalContentAlignment="Center"/></Grid></Border>
  <Grid x:Name="MusicWorkspace" Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="PlaylistsHeadingRow" Height="Auto"/><RowDefinition x:Name="PlaylistsListRow" Height="150"/><RowDefinition x:Name="NewPlaylistRow" Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="LIBRARY" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,10,0,6"/>
    <StackPanel Grid.Row="1"><RadioButton x:Name="ArtistCategoryButton" Content="Artists" GroupName="Category" Tag="Artist" Checked="Category_Checked" Style="{StaticResource NavButton}" IsChecked="True"/><RadioButton Content="Albums" GroupName="Category" Tag="Album" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Genres" GroupName="Category" Tag="Genre" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Songs" GroupName="Category" Tag="Songs" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton x:Name="IPodPodcastsCategoryButton" Content="Podcasts" GroupName="Category" Tag="Podcast" Checked="Category_Checked" Style="{StaticResource NavButton}" Visibility="Collapsed"/></StackPanel>
    <TextBlock x:Name="PlaylistsHeading" Grid.Row="3" Text="PLAYLISTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,12,0,6"/>
    <ListBox x:Name="PlaylistList" Grid.Row="4" ItemsSource="{Binding Playlists}" DisplayMemberPath="Name" SelectionChanged="PlaylistList_SelectionChanged" PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown" MouseMove="PlaylistList_MouseMove" AllowDrop="True" DragOver="Playlist_DragOver" Drop="Playlist_Drop" BorderThickness="0" Background="Transparent" Padding="5"/>
    <Button x:Name="NewPlaylistButton" Grid.Row="5" Content="＋  New playlist" HorizontalAlignment="Stretch" Click="NewPlaylist_Click"/>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="18,14,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="66" Height="66" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E6E9EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ToolTip="Artwork for the selected album or song">
      <Grid><TextBlock x:Name="AlbumArtworkPlaceholder" Text="♫" FontSize="30" Foreground="#9AA2AF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AlbumArtworkImage" Stretch="UniformToFill"/></Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Artists" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Foreground="#697181" Margin="0,3,0,0"/></StackPanel>
     <TextBox x:Name="SearchBox" Grid.Column="2" Height="32" Margin="0,0,8,0" VerticalAlignment="Top" VerticalContentAlignment="Center" Padding="9,0" TextChanged="SearchBox_TextChanged" ToolTip="Search this view"/>
     <Button x:Name="EditMetadataButton" Grid.Column="3" Content="Edit metadata" Click="EditMetadata_Click" VerticalAlignment="Top"/>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PrimaryColumn" Width="240"/><ColumnDefinition x:Name="SecondaryColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="PrimaryPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0"><DockPanel><TextBlock x:Name="PrimaryHeading" DockPanel.Dock="Top" Text="Artists" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA"/><ListBox x:Name="PrimaryList" SelectionMode="Extended" SelectionChanged="PrimaryList_SelectionChanged" PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown" MouseMove="PrimaryList_MouseMove" BorderThickness="0" Padding="3"/></DockPanel></Border>
     <Border x:Name="SecondaryPanel" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0"><DockPanel><TextBlock x:Name="SecondaryHeading" DockPanel.Dock="Top" Text="Albums" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA"/><ListBox x:Name="SecondaryList" SelectionMode="Extended" SelectionChanged="SecondaryList_SelectionChanged" PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown" MouseMove="SecondaryList_MouseMove" BorderThickness="0" Padding="3"/></DockPanel></Border>
     <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Grid>
      <DataGrid x:Name="TracksGrid" ItemsSource="{Binding VisibleTracks}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" AlternatingRowBackground="#FAFBFC" SelectionChanged="TracksGrid_SelectionChanged" MouseDoubleClick="TracksGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="TracksGrid_PreviewMouseLeftButtonDown" MouseMove="TracksGrid_MouseMove"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="42"/><DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="90"/><DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70"/><DataGridTextColumn Header="Bitrate" Binding="{Binding BitrateDisplay}" Width="80"/><DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="55"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="46" Foreground="#A8B0BE" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateTitle" Text="Drop music here to add it" FontSize="16" FontWeight="SemiBold" Foreground="#596273" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateDetail" Text="or choose File → Add files to library" Foreground="#8A92A0" HorizontalAlignment="Center" Margin="0,5"/></StackPanel>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Grid x:Name="PodcastWorkspace" Grid.Row="2" Visibility="Collapsed" Margin="18,14,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="PodcastSearchBox" Height="34" Padding="10,0" VerticalContentAlignment="Center" ToolTip="Search Apple Podcasts or paste an RSS feed URL" KeyDown="PodcastSearchBox_KeyDown"/>
    <Button Grid.Column="1" x:Name="PodcastSearchButton" Content="Search shows" Click="PodcastSearch_Click" Padding="18,7"/>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="SUBSCRIBED SHOWS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="8,0,0,7"/>
     <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
      <ListBox x:Name="PodcastShowsList" SelectionChanged="PodcastShowsList_SelectionChanged" BorderThickness="0" Padding="4"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E6E9EE" CornerRadius="4"><Image Source="{Binding ArtworkDisplay}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="8,1,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#737B89" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Border>
     <TextBlock x:Name="PodcastSearchResultsHeading" Grid.Row="2" Text="SEARCH RESULTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="8,12,0,7" Visibility="Collapsed"/>
     <ListBox x:Name="PodcastSearchResultsList" Grid.Row="3" MaxHeight="190" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Width="36" Height="36" Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Author}" Foreground="#737B89" FontSize="11"/></StackPanel><Button Grid.Column="2" Content="Subscribe" Click="PodcastSubscribe_Click" Padding="9,4"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <Grid x:Name="PodcastShowPanel" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="76" Height="76" HorizontalAlignment="Left" Background="#E6E9EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Image x:Name="PodcastShowArtwork" Stretch="UniformToFill"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PodcastShowTitle" Text="Select a podcast" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PodcastShowSummary" Foreground="#697181" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Refresh" Click="PodcastRefreshShow_Click"/><Button Content="Mark all played" Click="PodcastMarkAllPlayed_Click"/><Button Content="Delete downloads" Click="PodcastDeleteDownloads_Click"/><Button Content="Unsubscribe" Click="PodcastUnsubscribe_Click"/></StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="Keep" VerticalAlignment="Center"/><TextBox x:Name="PodcastSyncCountBox" Width="48" Height="28" Margin="7,0" VerticalContentAlignment="Center" TextAlignment="Center"/><TextBlock Text="episodes from the" VerticalAlignment="Center"/><ComboBox x:Name="PodcastSyncOrderCombo" Width="90" Height="28" Margin="7,0" SelectedIndex="0"><ComboBoxItem Content="Newest"/><ComboBoxItem Content="Oldest"/></ComboBox><TextBlock x:Name="PodcastRuleHint" Text="unplayed episodes, plus manually downloaded episodes" VerticalAlignment="Center"/><Button Content="Save rule" Click="PodcastSaveRule_Click" Padding="12,4" Margin="12,0,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Grid>
      <DataGrid x:Name="PodcastEpisodesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" AlternatingRowBackground="#FAFBFC"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Art" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Width="38" Height="38" Margin="4" Source="{Binding ArtworkDisplay}" Stretch="UniformToFill"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="#" Binding="{Binding EpisodeNumberDisplay}" Width="45"/><DataGridTextColumn Header="Episode" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Published" Binding="{Binding PublishedDisplay}" Width="105"/><DataGridTextColumn Header="Status / Progress" Binding="{Binding StateDisplay}" Width="250"/>
       <DataGridTemplateColumn Header="Actions" Width="330"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel>
        <Button Content="Play" Click="PodcastPlayEpisode_Click" Padding="8,3"/>
        <Button Content="Download" Click="PodcastDownloadEpisode_Click" Padding="8,3" Visibility="{Binding IsNotDownloaded, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Delete download" Click="PodcastDeleteEpisodeDownload_Click" Padding="8,3" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Mark played" Click="PodcastMarkEpisodePlayed_Click" Padding="8,3" Visibility="{Binding IsUnplayed, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Mark unplayed" Click="PodcastMarkEpisodeUnplayed_Click" Padding="8,3" Visibility="{Binding IsPlayed, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Sync" Click="PodcastSyncEpisode_Click" Padding="8,3"/>
       </WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid>
      <StackPanel x:Name="PodcastEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◉" FontSize="42" Foreground="#A8B0BE" HorizontalAlignment="Center"/><TextBlock Text="Search for a show and subscribe" FontSize="16" FontWeight="SemiBold" Foreground="#596273"/></StackPanel>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="DeviceStrip" Grid.Row="3" Background="#EDF0F4" BorderBrush="{StaticResource Line}" BorderThickness="0,1" AllowDrop="True" DragOver="DeviceStrip_DragOver" Drop="DeviceStrip_Drop"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="DeviceStatusArea" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonUp="DeviceStatusArea_MouseLeftButtonUp"><Ellipse x:Name="DeviceIndicator" Width="9" Height="9" Fill="#929AA7" Margin="0,0,9,0"/><TextBlock x:Name="DeviceNameText" Text="No iPod connected" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="DeviceDetailsText" Text="  •  Connect an iPod to view capacity and sync music" Foreground="#7C8492" VerticalAlignment="Center"/></StackPanel><ComboBox x:Name="TranscodeComboBox" Grid.Column="1" Width="190" Height="30" Margin="4" VerticalContentAlignment="Center" SelectedValuePath="Tag" SelectionChanged="TranscodeComboBox_SelectionChanged" ToolTip="Audio format used while syncing; imported files are never changed" SelectedIndex="0"><ComboBoxItem Content="Do not transcode (original)" Tag="original"/><ComboBoxItem Content="MP3 — 128 kbps" Tag="mp3-128"/><ComboBoxItem Content="MP3 — 192 kbps" Tag="mp3-192"/><ComboBoxItem Content="MP3 — 256 kbps" Tag="mp3-256"/><ComboBoxItem Content="MP3 — 320 kbps" Tag="mp3-320"/><ComboBoxItem Content="AAC — 128 kbps" Tag="aac-128"/><ComboBoxItem Content="AAC — 192 kbps" Tag="aac-192"/><ComboBoxItem Content="AAC — 256 kbps" Tag="aac-256"/><ComboBoxItem Content="Apple Lossless" Tag="alac"/></ComboBox><Button x:Name="EjectButton" Grid.Column="2" Content="Eject" Click="Eject_Click" IsEnabled="False" Padding="14,6"/><Button x:Name="SyncAllButton" Grid.Column="3" Content="Sync all" Click="SyncAll_Click" IsEnabled="False" Padding="18,6"/></Grid></Border>
  <Border Grid.Row="4" Background="White"><Grid Margin="16,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Grid.Column="1"><Button Content="|◀" Click="Previous_Click" ToolTip="Previous" FontSize="15"/><Button Content="▶" Click="Play_Click" ToolTip="Play" FontSize="17" Width="48"/><Button Content="Ⅱ" Click="Pause_Click" ToolTip="Pause" FontSize="15"/><Button Content="■" Click="Stop_Click" ToolTip="Stop" FontSize="14"/><Button Content="▶|" Click="Next_Click" ToolTip="Next" FontSize="15"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock x:Name="NowPlayingArtist" Foreground="#7B8390" FontSize="12" TextAlignment="Right"/></StackPanel></Grid></Border>
 </Grid>
</Window>
