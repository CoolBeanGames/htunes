     <TextBlock x:Name="PlaybackPositionText" Text="0:00" Foreground="#7B8390" FontSize="11" VerticalAlignment="Center" Width="38" TextAlignment="Right"/>
     <ProgressBar x:Name="PlaybackProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Margin="8,0"/>
     <TextBlock x:Name="PlaybackDurationText" Grid.Column="2" Text="0:00" Foreground="#7B8390" FontSize="11" VerticalAlignment="Center" Width="38"/>
