   </Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="PodcastHomePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="SUBSCRIBED SHOWS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="8,0,0,7"/>
     <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
      <Grid>
      <ListBox x:Name="PodcastShowsList" SelectionChanged="PodcastShowsList_SelectionChanged" BorderThickness="0" Padding="4"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="#2684FF" Visibility="{Binding HasNewEpisodes, Converter={StaticResource BoolToVisibility}}"/><Border Grid.Column="1" Width="42" Height="42" Background="#E6E9EE" CornerRadius="4"><Image Source="{Binding ArtworkDisplay}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="2" Margin="8,1,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#737B89" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <TextBlock x:Name="PodcastHomeEmpty" Text="Search for a show above or paste an RSS feed URL to subscribe." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#737B89" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <TextBlock x:Name="PodcastSearchResultsHeading" Grid.Row="2" Text="SEARCH RESULTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="8,12,0,7" Visibility="Collapsed"/>
