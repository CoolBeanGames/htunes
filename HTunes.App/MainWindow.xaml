<Window x:Class="HTunes.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="hTunes" Width="1280" Height="820" MinWidth="980" MinHeight="640" Background="#F4F5F7" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Window.Resources>
  <SolidColorBrush x:Key="Line" Color="#D8DCE3"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="NavButton" TargetType="RadioButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Padding="14,10" Background="Transparent" CornerRadius="5" Margin="5,1"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#E4ECFB"/><Setter Property="Foreground" Value="#174A9C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#EDF1F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Background="#FAFAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <MenuItem Header="_File"><MenuItem Header="Add files to library…" Click="AddFiles_Click"/><Separator/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="_Edit"><MenuItem Header="Edit selected metadata…" Click="EditMetadata_Click"/><MenuItem Header="Remove from library" Click="RemoveTracks_Click"/></MenuItem>
   <MenuItem Header="_View"><MenuItem Header="Music" IsChecked="True"/><MenuItem Header="Podcasts"/><MenuItem Header="Download"/></MenuItem>
   <MenuItem Header="_Playback"><MenuItem Header="Play" Click="Play_Click"/><MenuItem Header="Pause" Click="Pause_Click"/><MenuItem Header="Stop" Click="Stop_Click"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="About hTunes" Click="About_Click"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Width="570" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="MusicTab" Grid.Column="0" Content="♫  Music" Tag="Music" Checked="TopTab_Checked" Style="{StaticResource NavButton}" IsChecked="True" HorizontalContentAlignment="Center"/><RadioButton Grid.Column="1" Content="◉  Podcasts" Style="{StaticResource NavButton}" IsEnabled="False" ToolTip="Coming next" HorizontalContentAlignment="Center"/><RadioButton Grid.Column="2" Content="↓  Download" Style="{StaticResource NavButton}" IsEnabled="False" ToolTip="Coming next" HorizontalContentAlignment="Center"/><RadioButton x:Name="IPodTab" Grid.Column="3" Content="▣  iPod" Tag="IPod" Checked="TopTab_Checked" Style="{StaticResource NavButton}" Visibility="Collapsed" HorizontalContentAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="PlaylistsHeadingRow" Height="Auto"/><RowDefinition x:Name="PlaylistsListRow" Height="150"/><RowDefinition x:Name="NewPlaylistRow" Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="LIBRARY" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,10,0,6"/>
    <StackPanel Grid.Row="1"><RadioButton Content="Artists" GroupName="Category" Tag="Artist" Checked="Category_Checked" Style="{StaticResource NavButton}" IsChecked="True"/><RadioButton Content="Albums" GroupName="Category" Tag="Album" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Genres" GroupName="Category" Tag="Genre" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Songs" GroupName="Category" Tag="Songs" Checked="Category_Checked" Style="{StaticResource NavButton}"/></StackPanel>
    <TextBlock x:Name="PlaylistsHeading" Grid.Row="3" Text="PLAYLISTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,12,0,6"/>
    <ListBox x:Name="PlaylistList" Grid.Row="4" ItemsSource="{Binding Playlists}" DisplayMemberPath="Name" SelectionChanged="PlaylistList_SelectionChanged" AllowDrop="True" DragOver="Playlist_DragOver" Drop="Playlist_Drop" BorderThickness="0" Background="Transparent" Padding="5"/>
    <Button x:Name="NewPlaylistButton" Grid.Row="5" Content="＋  New playlist" HorizontalAlignment="Stretch" Click="NewPlaylist_Click"/>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="18,14,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Artists" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Foreground="#697181" Margin="0,3,0,12"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="9,0" TextChanged="SearchBox_TextChanged" ToolTip="Search this view"/><Button x:Name="EditMetadataButton" Grid.Column="2" Content="Edit metadata" Click="EditMetadata_Click" VerticalAlignment="Top"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PrimaryColumn" Width="240"/><ColumnDefinition x:Name="SecondaryColumn" Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="PrimaryPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0"><DockPanel><TextBlock x:Name="PrimaryHeading" DockPanel.Dock="Top" Text="Artists" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA"/><ListBox x:Name="PrimaryList" SelectionChanged="PrimaryList_SelectionChanged" BorderThickness="0" Padding="3"/></DockPanel></Border>
     <Border x:Name="SecondaryPanel" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0"><DockPanel><TextBlock x:Name="SecondaryHeading" DockPanel.Dock="Top" Text="Albums" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA"/><ListBox x:Name="SecondaryList" SelectionChanged="SecondaryList_SelectionChanged" BorderThickness="0" Padding="3"/></DockPanel></Border>
     <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Grid>
      <DataGrid x:Name="TracksGrid" ItemsSource="{Binding VisibleTracks}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" AlternatingRowBackground="#FAFBFC" MouseDoubleClick="TracksGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="TracksGrid_PreviewMouseLeftButtonDown" MouseMove="TracksGrid_MouseMove"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="42"/><DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="90"/><DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="55"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="46" Foreground="#A8B0BE" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateTitle" Text="Drop music here to add it" FontSize="16" FontWeight="SemiBold" Foreground="#596273" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateDetail" Text="or choose File → Add files to library" Foreground="#8A92A0" HorizontalAlignment="Center" Margin="0,5"/></StackPanel>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="DeviceStrip" Grid.Row="3" Background="#EDF0F4" BorderBrush="{StaticResource Line}" BorderThickness="0,1" AllowDrop="True" DragOver="DeviceStrip_DragOver" Drop="DeviceStrip_Drop"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="DeviceStatusArea" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonUp="DeviceStatusArea_MouseLeftButtonUp"><Ellipse x:Name="DeviceIndicator" Width="9" Height="9" Fill="#929AA7" Margin="0,0,9,0"/><TextBlock x:Name="DeviceNameText" Text="No iPod connected" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="DeviceDetailsText" Text="  •  Connect an iPod to view capacity and sync music" Foreground="#7C8492" VerticalAlignment="Center"/></StackPanel><Button x:Name="EjectButton" Grid.Column="1" Content="Eject" Click="Eject_Click" IsEnabled="False" Padding="14,6"/><Button x:Name="SyncAllButton" Grid.Column="2" Content="Sync all" IsEnabled="False" Padding="18,6"/></Grid></Border>
  <Border Grid.Row="4" Background="White"><Grid Margin="16,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Grid.Column="1"><Button Content="|◀" Click="Previous_Click" ToolTip="Previous" FontSize="15"/><Button Content="▶" Click="Play_Click" ToolTip="Play" FontSize="17" Width="48"/><Button Content="Ⅱ" Click="Pause_Click" ToolTip="Pause" FontSize="15"/><Button Content="■" Click="Stop_Click" ToolTip="Stop" FontSize="14"/><Button Content="▶|" Click="Next_Click" ToolTip="Next" FontSize="15"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock x:Name="NowPlayingArtist" Foreground="#7B8390" FontSize="12" TextAlignment="Right"/></StackPanel></Grid></Border>
 </Grid>
</Window>
