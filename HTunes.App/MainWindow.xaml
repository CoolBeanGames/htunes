    </Grid>
    <Grid x:Name="PodcastShowPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="76" Height="76" HorizontalAlignment="Left" Background="#E6E9EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Image x:Name="PodcastShowArtwork" Stretch="UniformToFill"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PodcastShowTitle" Text="Select a podcast" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PodcastShowSummary" Foreground="#697181" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Refresh" Click="PodcastRefreshShow_Click"/><Button Content="Mark all played" Click="PodcastMarkAllPlayed_Click"/><Button Content="Delete downloads" Click="PodcastDeleteDownloads_Click"/><Button Content="Unsubscribe" Click="PodcastUnsubscribe_Click"/></StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="Keep" VerticalAlignment="Center"/><TextBox x:Name="PodcastSyncCountBox" Width="48" Height="28" Margin="7,0" VerticalContentAlignment="Center" TextAlignment="Center"/><TextBlock Text="episodes from the" VerticalAlignment="Center"/><ComboBox x:Name="PodcastSyncOrderCombo" Width="90" Height="28" Margin="7,0" SelectedIndex="0"><ComboBoxItem Content="Newest"/><ComboBoxItem Content="Oldest"/></ComboBox><TextBlock x:Name="PodcastRuleHint" Text="unplayed episodes, plus manually downloaded episodes" VerticalAlignment="Center"/><Button Content="Save rule" Click="PodcastSaveRule_Click" Padding="12,4" Margin="12,0,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><Grid>
      <DataGrid x:Name="PodcastEpisodesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" AlternatingRowBackground="#FAFBFC" MouseDoubleClick="PodcastEpisodesGrid_MouseDoubleClick"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Art" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Width="38" Height="38" Margin="4" Source="{Binding ArtworkDisplay}" Stretch="UniformToFill"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="#" Binding="{Binding EpisodeNumberDisplay}" SortMemberPath="NaturalEpisodeNumber" Width="45"/><DataGridTextColumn Header="Episode" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Published" Binding="{Binding PublishedDisplay}" Width="105"/><DataGridTextColumn Header="Duration / Resume" Binding="{Binding DurationDisplay}" SortMemberPath="DurationMs" Width="170"/><DataGridTextColumn Header="Status / Progress" Binding="{Binding StateDisplay}" Width="250"/>
       <DataGridTemplateColumn Header="Actions" Width="330"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel>
        <Button Content="Play" Click="PodcastPlayEpisode_Click" Padding="8,3"/>
        <Button Content="Download" Click="PodcastDownloadEpisode_Click" Padding="8,3" Visibility="{Binding IsNotDownloaded, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Delete download" Click="PodcastDeleteEpisodeDownload_Click" Padding="8,3" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Mark played" Click="PodcastMarkEpisodePlayed_Click" Padding="8,3" Visibility="{Binding IsUnplayed, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Mark unplayed" Click="PodcastMarkEpisodeUnplayed_Click" Padding="8,3" Visibility="{Binding IsPlayed, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Sync" Click="PodcastSyncEpisode_Click" Padding="8,3"/>
       </WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid>
      <StackPanel x:Name="PodcastEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◉" FontSize="42" Foreground="#A8B0BE" HorizontalAlignment="Center"/><TextBlock Text="No episodes yet — refresh this show to check its feed" FontSize="16" FontWeight="SemiBold" Foreground="#596273"/></StackPanel>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="DeviceStrip" Grid.Row="3" Background="#E3E6EA" BorderBrush="{StaticResource Line}" BorderThickness="0,1" AllowDrop="True" DragOver="DeviceStrip_DragOver" Drop="DeviceStrip_Drop"><Grid ClipToBounds="True"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="DeviceStatusArea" Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonUp="DeviceStatusArea_MouseLeftButtonUp"><TextBlock Text="▣" FontSize="18" Foreground="#44698F" Margin="0,0,7,0" VerticalAlignment="Center"/><Ellipse x:Name="DeviceIndicator" Width="9" Height="9" Fill="#929AA7" Margin="0,0,9,0"/><TextBlock x:Name="DeviceNameText" Text="No iPod connected" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="DeviceDetailsText" Text="  •  Connect an iPod to view capacity and sync music" Foreground="#5E6877" VerticalAlignment="Center"/></StackPanel><ComboBox x:Name="TranscodeComboBox" Grid.Column="1" Width="190" Height="30" Margin="4" VerticalContentAlignment="Center" SelectedValuePath="Tag" SelectionChanged="TranscodeComboBox_SelectionChanged" ToolTip="Audio format used while syncing; imported files are never changed" SelectedIndex="0"><ComboBoxItem Content="Do not transcode (original)" Tag="original"/><ComboBoxItem Content="MP3 — 128 kbps" Tag="mp3-128"/><ComboBoxItem Content="MP3 — 192 kbps" Tag="mp3-192"/><ComboBoxItem Content="MP3 — 256 kbps" Tag="mp3-256"/><ComboBoxItem Content="MP3 — 320 kbps" Tag="mp3-320"/><ComboBoxItem Content="AAC — 128 kbps" Tag="aac-128"/><ComboBoxItem Content="AAC — 192 kbps" Tag="aac-192"/><ComboBoxItem Content="AAC — 256 kbps" Tag="aac-256"/><ComboBoxItem Content="Apple Lossless" Tag="alac"/></ComboBox><Button x:Name="SyncCurrentButton" Grid.Column="2" Click="SyncCurrent_Click" IsEnabled="False" Padding="14,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="SyncCurrentDot" Width="7" Height="7" Fill="#2684FF" Margin="0,0,6,0"/><TextBlock x:Name="SyncCurrentText" Text="Sync music"/></StackPanel></Button><Button x:Name="SyncAllButton" Grid.Column="3" Content="Sync all" Click="SyncAll_Click" IsEnabled="False" Padding="18,6"/><Button x:Name="StopSyncButton" Grid.Column="4" Content="Stop sync" Click="StopSync_Click" Visibility="Collapsed" Padding="14,6"/><Button x:Name="EjectButton" Grid.Column="5" Content="⏏" ToolTip="Eject iPod" Click="Eject_Click" IsEnabled="False" FontSize="17" Padding="12,4"/></Grid><Canvas x:Name="SyncAnimationLayer" IsHitTestVisible="False" SizeChanged="SyncAnimationLayer_SizeChanged"/></Grid></Border>
  <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="16,7">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="60" Height="60" VerticalAlignment="Center" Background="#E6E9EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" ToolTip="{Binding Text, ElementName=NowPlayingTitle}">
