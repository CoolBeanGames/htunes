<Window x:Class="HTunes.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HTunes.App"
 Title="hTunes" Width="1280" Height="820" MinWidth="980" MinHeight="640" Background="#F4F5F7" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Window.Resources>
  <SolidColorBrush x:Key="Line" Color="#D8DCE3"/>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="NavButton" TargetType="RadioButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Grid Margin="5,1">
    <Grid x:Name="Pulse" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
     <Grid.Effect><BlurEffect Radius="7"/></Grid.Effect>
     <Ellipse x:Name="Pulse1" Fill="#3C74C4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2"/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Pulse2" Fill="#3C74C4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2"/></Ellipse.RenderTransform></Ellipse>
     <Ellipse x:Name="Pulse3" Fill="#3C74C4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2"/></Ellipse.RenderTransform></Ellipse>
    </Grid>
    <Border x:Name="B" Padding="14,10" Background="Transparent" CornerRadius="5"><ContentPresenter VerticalAlignment="Center"/></Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#E4ECFB"/><Setter Property="Foreground" Value="#174A9C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#EDF1F8"/></Trigger>
    <Trigger Property="local:TabPulse.IsActive" Value="True">
     <Trigger.EnterActions><BeginStoryboard x:Name="PulseStoryboard"><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
      <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1.7" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="1.7" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="Opacity" From="0.62" To="0" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1.7" BeginTime="0:0:0.6" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="1.7" BeginTime="0:0:0.6" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="Opacity" From="0.62" To="0" BeginTime="0:0:0.6" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.2" To="1.7" BeginTime="0:0:1.2" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="1.7" BeginTime="0:0:1.2" Duration="0:0:1.8" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Pulse3" Storyboard.TargetProperty="Opacity" From="0.62" To="0" BeginTime="0:0:1.2" Duration="0:0:1.8" RepeatBehavior="Forever"/>
     </Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><StopStoryboard BeginStoryboardName="PulseStoryboard"/></Trigger.ExitActions>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#E4ECFB"/><Setter Property="Foreground" Value="#174A9C"/><Setter Property="BorderBrush" Value="#9DBBE8"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="0,0,22,0"/><Button x:Name="ClearText" Content="×" Click="ClearTextButton_Click" Width="20" Height="20" Padding="0" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#697181" ToolTip="Clear"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="ClearText" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter TargetName="ClearText" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="82"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Background="#FAFAFB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <MenuItem x:Name="FileMenu" Header="_File"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="EditMenu" Header="_Edit"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="ViewMenu" Header="_View"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem x:Name="PlaybackMenu" Header="_Playback"><MenuItem Header="Loading…" IsEnabled="False"/></MenuItem>
   <MenuItem Header="_Settings"><MenuItem Header="Settings…" Click="Settings_Click"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="About hTunes" Click="About_Click"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" ClipToBounds="True"><Grid Width="820" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="MusicTab" Grid.Column="0" Content="♫  Music" Tag="Music" Checked="TopTab_Checked" Style="{StaticResource NavButton}" IsChecked="True" HorizontalContentAlignment="Center"/><RadioButton x:Name="PodcastsTab" Grid.Column="1" Content="◉  Podcasts" Tag="Podcasts" Checked="TopTab_Checked" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"/><RadioButton x:Name="DownloadTab" Grid.Column="2" Content="↓  Download" Tag="Download" Checked="TopTab_Checked" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"/><RadioButton x:Name="TagTab" Grid.Column="3" Content="◇  Tag" Tag="Tag" Checked="TopTab_Checked" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"/><RadioButton x:Name="RenameTab" Grid.Column="4" Content="↔  Rename" Tag="Rename" Checked="TopTab_Checked" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"/><RadioButton x:Name="IPodTab" Grid.Column="5" Content="▣  iPod" Tag="IPod" Checked="TopTab_Checked" Style="{StaticResource NavButton}" Visibility="Collapsed" HorizontalContentAlignment="Center"/></Grid></Border>
  <Grid x:Name="MusicWorkspace" Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="PlaylistsHeadingRow" Height="Auto"/><RowDefinition x:Name="PlaylistsListRow" Height="150"/><RowDefinition x:Name="NewPlaylistRow" Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="LIBRARY" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,10,0,6"/>
    <StackPanel Grid.Row="1"><RadioButton x:Name="ArtistCategoryButton" Content="Artists" GroupName="Category" Tag="Artist" Checked="Category_Checked" Style="{StaticResource NavButton}" IsChecked="True"/><RadioButton Content="Albums" GroupName="Category" Tag="Album" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Genres" GroupName="Category" Tag="Genre" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton Content="Songs" GroupName="Category" Tag="Songs" Checked="Category_Checked" Style="{StaticResource NavButton}"/><RadioButton x:Name="IPodPodcastsCategoryButton" Content="Podcasts" GroupName="Category" Tag="Podcast" Checked="Category_Checked" Style="{StaticResource NavButton}" Visibility="Collapsed"/></StackPanel>
    <TextBlock x:Name="PlaylistsHeading" Grid.Row="3" Text="PLAYLISTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,12,0,6"/>
    <ListBox x:Name="PlaylistList" Grid.Row="4" ItemsSource="{Binding Playlists}" DisplayMemberPath="Name" SelectionChanged="PlaylistList_SelectionChanged" PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown" MouseMove="PlaylistList_MouseMove" AllowDrop="True" DragOver="Playlist_DragOver" Drop="Playlist_Drop" BorderThickness="0" Background="Transparent" Padding="5"/>
    <TextBlock x:Name="IPodPlaylistsHeading" Grid.Row="3" Text="IPOD PLAYLISTS" Foreground="#737B89" FontSize="11" FontWeight="Bold" Margin="12,12,0,6" Visibility="Collapsed"/>
    <ListBox x:Name="IPodPlaylistList" Grid.Row="4" DisplayMemberPath="Display" SelectionChanged="IPodPlaylistList_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="5" Visibility="Collapsed"/>
    <Button x:Name="NewPlaylistButton" Grid.Row="5" Content="＋  New playlist" HorizontalAlignment="Stretch" Click="NewPlaylist_Click"/>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="18,14,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="MusicBackButton" Grid.Row="0" Content="← Back" Click="BrowseBack_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="Go back (Alt+Left)"/>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <Border Width="66" Height="66" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E6E9EE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" ToolTip="Artwork for the selected album or song">
      <Grid><TextBlock x:Name="AlbumArtworkPlaceholder" Text="♫" FontSize="30" Foreground="#9AA2AF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AlbumArtworkImage" Stretch="UniformToFill"/></Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Artists" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Foreground="#697181" Margin="0,3,0,0"/></StackPanel>
     <TextBox x:Name="SearchBox" Grid.Column="2" Height="32" Margin="0,0,8,0" VerticalAlignment="Top" VerticalContentAlignment="Center" Padding="9,0" TextChanged="SearchBox_TextChanged" ToolTip="Search this view"/>
    </Grid>
    <Grid Grid.Row="2">
     <Border x:Name="PrimaryPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><DockPanel><TextBlock x:Name="PrimaryHeading" DockPanel.Dock="Top" Text="Artists" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA" TextWrapping="Wrap"/><ListBox x:Name="PrimaryList" SelectionMode="Extended" SelectionChanged="PrimaryList_SelectionChanged" PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown" MouseMove="PrimaryList_MouseMove" BorderThickness="0" Padding="8" FontSize="16"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#2684FF" Margin="0,0,8,0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
     <Border x:Name="SecondaryPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed"><DockPanel><TextBlock x:Name="SecondaryHeading" DockPanel.Dock="Top" Text="Albums" FontWeight="SemiBold" Padding="12,10" Background="#F7F8FA"/><ListBox x:Name="SecondaryList" SelectionMode="Extended" SelectionChanged="SecondaryList_SelectionChanged" PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown" MouseMove="SecondaryList_MouseMove" BorderThickness="0" Padding="8" FontSize="16"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#2684FF" Margin="0,0,8,0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
     <Border x:Name="TracksPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed"><Grid>
      <DataGrid x:Name="TracksGrid" ItemsSource="{Binding VisibleTracks}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" AlternatingRowBackground="#FAFBFC" SelectionChanged="TracksGrid_SelectionChanged" MouseDoubleClick="TracksGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="TracksGrid_PreviewMouseLeftButtonDown" MouseMove="TracksGrid_MouseMove"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding HasMissingMetadata}" Value="True"><Setter Property="Background" Value="#FFF0D8"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTemplateColumn Header="" Width="26" SortMemberPath="IsNew"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="8" Height="8" Fill="#2684FF" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="42"/><DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="90"/><DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70"/><DataGridTextColumn Header="Bitrate" Binding="{Binding BitrateDisplay}" Width="80"/><DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="55"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="46" Foreground="#A8B0BE" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateTitle" Text="Drop music here to add it" FontSize="16" FontWeight="SemiBold" Foreground="#596273" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateDetail" Text="or choose File → Add files to library" Foreground="#8A92A0" HorizontalAlignment="Center" Margin="0,5"/></StackPanel>
     </Grid></Border>
     <TextBlock x:Name="BrowseEmptyState" Text="No items found. Drop music here to add it." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#737B89" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
   </Grid>
  </Grid>
  <Grid x:Name="RenameWorkspace" Grid.Row="2" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="400"/></Grid.ColumnDefinitions>
   <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,12"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><TextBlock x:Name="RenameScopeSummary" Text="Select tracks to preview" Foreground="#697181" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RenameApplyButton" Content="Apply renames" Click="RenameApply_Click" Background="#2D6CDF" Foreground="White" Margin="0,0,6,0"/><Button x:Name="RenameResetButton" Grid.Column="1" Content="Reset" Click="RenameReset_Click" Margin="0"/></Grid></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="RENAME RULES" Foreground="#697181" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Apply to" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="RenameScopeCombo" SelectedIndex="0" Padding="5" SelectionChanged="RenameOptions_Changed"><ComboBoxItem Content="Selected tracks"/><ComboBoxItem Content="All filtered tracks"/><ComboBoxItem Content="Entire library (including hidden tracks)"/></ComboBox>
     <TextBlock Text="Action" FontWeight="SemiBold" Margin="0,12,0,4"/><ComboBox x:Name="RenameModeCombo" SelectedIndex="0" Padding="5" SelectionChanged="RenameOptions_Changed"><ComboBoxItem Content="Edit filenames"/><ComboBoxItem Content="Artist - Album - Track → filename"/><ComboBoxItem Content="Filename → track title"/></ComboBox>
     <TextBlock x:Name="RenameModeHint" Text="Rules run top to bottom on the filename only." FontSize="11" Foreground="#697181" TextWrapping="Wrap" Margin="0,7,0,7"/>
     <CheckBox x:Name="RenameWriteTitles" Content="Also write title tags to audio files" IsChecked="True" Visibility="Collapsed" Margin="0,3,0,10" Checked="RenameOptions_Changed" Unchecked="RenameOptions_Changed"/>
     <StackPanel x:Name="RenameRulesPanel"/>
     <CheckBox x:Name="RenameIgnoreCase" Content="Ignore case when replacing / removing" FontSize="11" Margin="0,6,0,10" Checked="RenameOptions_Changed" Unchecked="RenameOptions_Changed"/>
     <Border Background="#EAF0FA" CornerRadius="4" Padding="9"><TextBlock Text="Extensions and folders stay unchanged. Nothing is renamed until you apply." Foreground="#31547B" FontSize="12" TextWrapping="Wrap"/></Border>
    </StackPanel></ScrollViewer>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E4E8EF"/>
   <Grid Grid.Column="2" Margin="16,12,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rename files" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="RenameLibrarySummary" Text="All library tracks" Foreground="#697181" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Search library" FontSize="11" Foreground="#697181" Margin="0,0,0,3"/><TextBox x:Name="RenameSearchBox" Height="30" Padding="8,0" VerticalContentAlignment="Center" TextChanged="RenameSearch_Changed" ToolTip="Search title, artist, album, genre, or file path (Ctrl+F)"/></StackPanel></Grid>
    <TextBlock Grid.Row="1" Text="Live preview • Ctrl / Shift for multi-select • Ctrl+A selects all filtered rows • Sort or resize any column" Foreground="#697181" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
    <Grid Grid.Row="2"><DataGrid x:Name="RenameTracksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#EDF0F4" VerticalGridLinesBrush="#EDF0F4" Background="White" AlternatingRowBackground="#F8FAFD" BorderBrush="{StaticResource Line}" RowHeight="34" SelectionChanged="RenameSelection_Changed"><DataGrid.Columns>
     <DataGridTextColumn Header="Current filename" Binding="{Binding CurrentName}" Width="280"/><DataGridTextColumn x:Name="RenameProposedColumn" Header="New filename" Binding="{Binding Proposed}" Width="310"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200"/><DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="80"/><DataGridTextColumn Header="Track title" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="160"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="180"/><DataGridTextColumn Header="Folder" Binding="{Binding DirectoryName}" Width="350"/>
    </DataGrid.Columns><DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4ECFB"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#174A9C"/></DataGrid.Resources></DataGrid><TextBlock x:Name="RenameEmptyState" Text="Import music to start renaming, or clear the search." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#697181" IsHitTestVisible="False"/></Grid>
    <TextBlock x:Name="RenameStatus" Grid.Row="3" Text="Library paths and playlist references are kept in sync. Undo is available after applying." Foreground="#697181" TextWrapping="Wrap" Margin="0,9,0,0"/>
   </Grid>
  </Grid>
  <Grid x:Name="TagWorkspace" Grid.Row="2" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="400"/></Grid.ColumnDefinitions>
   <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><CheckBox x:Name="TagWriteFiles" Content="Write tags to audio files" IsChecked="True" Margin="0,0,0,5" ToolTip="Enabled: save to the original audio files and library. Disabled: library-only edits."/><CheckBox x:Name="TagForceAuto" Content="Force auto-tag (replace existing / retry tagged)" FontSize="11" Margin="0,0,0,4"/><Button x:Name="TagAutoButton" Content="Auto-tag selection (MusicBrainz)" Click="TagAuto_Click" Margin="0,0,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="TagApplyButton" Content="Apply to selection" Click="TagApply_Click" Background="#2D6CDF" Foreground="White" Margin="0,3,6,0"/><Button x:Name="TagResetButton" Grid.Column="1" Content="Reset" Click="TagReset_Click" Margin="0,3,0,0"/></Grid></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="TagInspector">
       <TextBlock Text="INSPECTOR" Foreground="#697181" FontSize="11" FontWeight="Bold"/>
       <TextBlock x:Name="TagSelectionSummary" Text="Select tracks to edit" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="90" Height="90" Background="#E7EBF2" BorderBrush="{StaticResource Line}" BorderThickness="1"><Grid><TextBlock x:Name="TagArtworkPlaceholder" Text="No artwork" Foreground="#697181" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="TagArtworkImage" Stretch="Uniform"/></Grid></Border>
        <StackPanel Grid.Column="1"><Button Content="Upload artwork…" Click="TagUploadArtwork_Click" Margin="0,0,0,4"/><Button Content="Remove artwork" Click="TagRemoveArtwork_Click" Margin="0,0,0,4"/><TextBlock x:Name="TagArtworkInfo" Text="JPG, PNG, BMP" FontSize="11" Foreground="#697181" TextWrapping="Wrap"/></StackPanel>
       </Grid>
       <CheckBox x:Name="TagResizeArtwork" Content="Resize artwork on save" Margin="0,10,0,5" Checked="TagOptionChanged" Unchecked="TagOptionChanged"/>
       <StackPanel Orientation="Horizontal"><TextBox x:Name="TagArtworkWidth" Text="600" Width="56" Padding="5,3" TextChanged="TagSizeChanged" ToolTip="Maximum width (16–4096 pixels)"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="TagArtworkHeight" Text="600" Width="56" Padding="5,3" TextChanged="TagSizeChanged" ToolTip="Maximum height (16–4096 pixels)"/><TextBlock Text=" px" FontSize="11" Foreground="#697181" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
       <CheckBox x:Name="TagCropArtwork" Content="Crop to fill (trim side/top bars)" FontSize="11" Margin="0,5,0,0" Checked="TagOptionChanged" Unchecked="TagOptionChanged" ToolTip="Scale to cover the target size and trim the overflow from the centre, instead of fitting the whole image inside it"/>
       <TextBlock Text="Checked fields apply to every selected track." FontSize="11" Foreground="#697181" Margin="0,10,0,6" TextWrapping="Wrap"/>
       <StackPanel x:Name="TagFieldsPanel"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E4E8EF"/>
   <Grid Grid.Column="2" Margin="16,12,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tag editor" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="TagLibrarySummary" Text="All library tracks" Foreground="#697181" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="TagSearchBox" Grid.Column="1" Height="32" VerticalAlignment="Center" Padding="9,0" VerticalContentAlignment="Center" TextChanged="TagSearch_TextChanged" ToolTip="Search title, artist, album, genre, or file path (Ctrl+F)"/></Grid>
    <TextBlock Grid.Row="1" Text="Ctrl / Shift to select • Ctrl+A to select all • Click a column to sort • Drag column edges to resize" FontSize="12" Foreground="#697181" Margin="0,0,0,10" TextWrapping="Wrap"/>
    <Grid Grid.Row="2"><DataGrid x:Name="TagTracksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserReorderColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#EDF0F4" VerticalGridLinesBrush="#EDF0F4" Background="White" AlternatingRowBackground="#F8FAFD" BorderBrush="{StaticResource Line}" RowHeight="32" SelectionChanged="TagSelection_Changed"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding HasMissingMetadata}" Value="True"><Setter Property="Background" Value="#FFF0D8"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns>
     <DataGridTemplateColumn Header="" Width="26" SortMemberPath="IsNew"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="8" Height="8" Fill="#2684FF" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="240"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="160"/><DataGridTextColumn Header="Album artist" Binding="{Binding AlbumArtist}" Width="160"/><DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="180"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="105"/><DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="48"/><DataGridTextColumn Header="Disc" Binding="{Binding DiscNumber}" Width="48"/><DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="65"/><DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="75"/><DataGridTextColumn Header="Bitrate" Binding="{Binding BitrateDisplay}" SortMemberPath="BitrateKbps" Width="80"/><DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" Width="60"/><DataGridTextColumn Header="Added" Binding="{Binding DateAdded, StringFormat=d}" Width="100"/><DataGridTextColumn Header="File path" Binding="{Binding FilePath}" Width="420"/>
    </DataGrid.Columns><DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4ECFB"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#174A9C"/></DataGrid.Resources></DataGrid><TextBlock x:Name="TagEmptyState" Text="No tracks found. Import music or clear the search." Foreground="#697181" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <TextBlock x:Name="TagStatus" Grid.Row="3" Text="Edits affect your local library. iPod copies are not changed here." Foreground="#697181" Margin="0,9,0,0" TextWrapping="Wrap"/>
   </Grid>
  </Grid>
  <Grid x:Name="DownloadWorkspace" Grid.Row="2" Visibility="Collapsed" Margin="18,14,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Download audio — paste one link per line" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBox x:Name="DownloadLinksBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10" FontSize="14" ToolTip="One HTTP or HTTPS link per line. Playlist behavior follows Settings → yt-dlp."/>
   <DockPanel Grid.Row="2" Margin="0,8,0,8"><Button x:Name="DownloadSettingsButton" DockPanel.Dock="Right" Content="Download settings…" Click="Settings_Click"/><Button x:Name="DownloadStartButton" DockPanel.Dock="Left" Content="Download links" Click="DownloadLinks_Click" Padding="20,7"/><Button DockPanel.Dock="Left" Content="Clear" Click="ClearDownloadLinks_Click"/><TextBlock Text="Links run one at a time. Finished audio is added to Music using your import settings." VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/></DockPanel>
   <Border Grid.Row="3" Background="#F7F8FA" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="Metadata override — applied to every track once it downloads. Blank keeps the file's own tag. Cleared together with the links box." FontSize="11" Foreground="#697181" Margin="0,0,0,7" TextWrapping="Wrap"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,6,0"><TextBlock Text="Artist" FontSize="11" Foreground="#697181"/><TextBox x:Name="DownloadOverrideArtist" Padding="5,3"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Album artist" FontSize="11" Foreground="#697181"/><TextBox x:Name="DownloadOverrideAlbumArtist" Padding="5,3"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Album" FontSize="11" Foreground="#697181"/><TextBox x:Name="DownloadOverrideAlbum" Padding="5,3"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="Genre" FontSize="11" Foreground="#697181"/><TextBox x:Name="DownloadOverrideGenre" Padding="5,3"/></StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="82" Height="82" Background="#E7EBF2" CornerRadius="4"><Grid><TextBlock x:Name="DownloadArtworkPlaceholder" Text="♫" FontSize="30" Foreground="#9AA2AF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DownloadArtworkImage" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1"><TextBlock x:Name="DownloadTrackTitle" Text="No download running" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="0,5,0,5"><TextBlock x:Name="DownloadLinkProgress" Text="Links: 0" Margin="0,0,24,0"/><TextBlock x:Name="DownloadTrackProgress" Text="Track — of — in this link"/></WrapPanel><ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Margin="0,2,0,6"/><TextBlock x:Name="DownloadStatus" Text="Ready. Track totals appear as yt-dlp discovers the link." TextWrapping="Wrap" Foreground="#697181"/><TextBlock x:Name="DownloadBatchSummary" Text="" Foreground="#697181" Margin="0,4,0,0"/></StackPanel>
    <Button x:Name="DownloadAbortButton" Grid.Column="2" Content="Abort" Click="AbortDownloads_Click" IsEnabled="False" VerticalAlignment="Top" Margin="16,0,0,0" Padding="18,7"/>
   </Grid></Border>
   <TextBlock Grid.Row="5" Text="yt-dlp output" FontWeight="SemiBold" Margin="0,0,0,5"/>
