       <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" Foreground="White" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="NowPlayingArtist" Text="" Foreground="#D6DCE6" FontSize="8.5" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="14,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
