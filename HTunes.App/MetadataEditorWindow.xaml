<Window x:Class="HTunes.App.MetadataEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit metadata" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F5F7">
 <Grid Margin="20" Width="560"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Grid.RowSpan="6" Width="125" Height="125" VerticalAlignment="Top" BorderBrush="#CCD1D9" BorderThickness="1" Background="White"><Grid><Image x:Name="Artwork" Stretch="UniformToFill"/><TextBlock x:Name="ArtworkPlaceholder" Text="No artwork" Foreground="#8A92A0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
  <StackPanel Grid.Column="1"><TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Blank fields leave existing values unchanged for multi-edit." Foreground="#747D8C" Margin="0,3,0,12"/></StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Title"/><TextBox x:Name="TitleBox" Margin="0,3,0,8" Padding="6"/></StackPanel>
  <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Artist"/><TextBox x:Name="ArtistBox" Margin="0,3,0,8" Padding="6"/></StackPanel>
  <StackPanel Grid.Row="3" Grid.Column="1"><TextBlock Text="Album artist (optional)"/><TextBox x:Name="AlbumArtistBox" Margin="0,3,0,8" Padding="6"/></StackPanel>
  <StackPanel Grid.Row="4" Grid.Column="1"><TextBlock Text="Album"/><TextBox x:Name="AlbumBox" Margin="0,3,0,8" Padding="6"/></StackPanel>
  <StackPanel Grid.Row="5" Grid.Column="1"><TextBlock Text="Genre"/><TextBox x:Name="GenreBox" Margin="0,3,0,8" Padding="6"/></StackPanel>
  <Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Track #"/><TextBox x:Name="TrackBox" Margin="0,3,8,8" Padding="6"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Disc #"/><TextBox x:Name="DiscBox" Margin="0,3,8,8" Padding="6"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Year"/><TextBox x:Name="YearBox" Margin="0,3,0,8" Padding="6"/></StackPanel></Grid>
  <Button Grid.Row="7" Content="Choose album art…" Click="ChooseArtwork_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0"/>
  <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" Padding="18,7" Margin="4"/><Button Content="Save changes" IsDefault="True" Click="Save_Click" Padding="18,7" Margin="4" Background="#2D6CDF" Foreground="White"/></StackPanel>
 </Grid>
</Window>
