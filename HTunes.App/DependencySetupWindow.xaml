<Window x:Class="HTunes.App.DependencySetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="hTunes tool updates" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F5F7" ShowInTaskbar="False">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="HeadingText" Text="Tool updates are available" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#596273" Text="hTunes can download these tools into its private app-data folder. This does not require administrator access and will not change your system settings."/>
  <ItemsControl x:Name="MissingToolsList" Grid.Row="2" Margin="0,0,0,12">
   <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D8DCE3" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,3"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#697181" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <StackPanel Grid.Row="3" Margin="0,0,0,12">
   <TextBlock x:Name="ProgressText" Text="FFmpeg comes from the Gyan Windows builds; yt-dlp comes from its official GitHub release. Published checksums are verified before installation." Foreground="#697181" TextWrapping="Wrap"/>
   <ProgressBar x:Name="DownloadProgress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="ContinueButton" Content="Not now" Padding="14,7" Margin="4" Click="Continue_Click" IsCancel="True"/>
   <Button x:Name="DownloadButton" Content="Install updates" Padding="16,7" Margin="4" Click="Download_Click" IsDefault="True" Background="#E4ECFB"/>
  </StackPanel>
 </Grid>
</Window>
